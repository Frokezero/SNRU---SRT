# Flask Server Configuration
SECRET_KEY=super-secret-key-change-this
APP_ENV=development
DATABASE_PATH=database.sqlite
SESSION_TIMEOUT_MINUTES=60
LOG_LEVEL=INFO
ENABLE_AI_ASSISTANT=false
AI_INCLUDE_PERSONAL_CONTEXT=false
PUBLIC_BASE_URL=http://localhost:5000
REQUIRE_CHECKIN_GPS=true
CHECKIN_RADIUS_METERS=250
SESSION_BACKEND=cookie
REDIS_URL=redis://127.0.0.1:6379/0
BEHIND_PROXY=false
PORT=5000
OUTBOX_WORKER_ENABLED=true

# Email SMTP Settings (persisted outbox with automatic retry)
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# LINE Notification Settings (LINE Messaging API)
# Get these credentials from your LINE Developers Console (https://developers.line.biz)
LINE_CHANNEL_ACCESS_TOKEN=your_line_bot_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_bot_channel_secret_here
LINE_ADMIN_USER_ID=your_line_admin_or_group_id_here
